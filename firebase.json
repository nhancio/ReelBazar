{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "backend/server",
    "runtime": "nodejs22",
    "predeploy": [
      "npm --workspace backend/server run build"
    ],
    "ignore": [
      "node_modules",
      ".git",
      ".vercel",
      "firebase-debug.log",
      "firebase-debug.*.log",
      ".runtimeconfig.json",
      ".env",
      ".env.*",
      "serviceAccountKey.json",
      "api",
      "public"
    ]
  },
  "hosting": [
    {
      "site": "reelbaazar",
      "public": "apps/web-app/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/*.MOV"
      ],
      "rewrites": [
        {
          "source": "/api",
          "function": {
            "functionId": "api",
            "region": "us-central1"
          }
        },
        {
          "source": "/api/**",
          "function": {
            "functionId": "api",
            "region": "us-central1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "site": "reelbaazar-landing",
      "public": "apps/landing-page/out",
      "cleanUrls": true,
      "trailingSlash": false,
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/site.webmanifest",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400, stale-while-revalidate=604800"
            }
          ]
        },
        {
          "source": "/logo/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/media/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600, stale-while-revalidate=86400"
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/app",
          "destination": "https://app.rava.one/",
          "type": 301
        },
        {
          "source": "/app/**",
          "destination": "https://app.rava.one/:splat",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "/api",
          "function": {
            "functionId": "api",
            "region": "us-central1"
          }
        },
        {
          "source": "/api/**",
          "function": {
            "functionId": "api",
            "region": "us-central1"
          }
        }
      ]
    }
  ]
}
