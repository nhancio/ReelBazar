# Firebase Admin
RAVA_FIREBASE_PROJECT_ID=your-project-id
RAVA_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
RAVA_FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
RAVA_FIREBASE_CLIENT_EMAIL=
RAVA_FIREBASE_PRIVATE_KEY=
RAVA_FIREBASE_SERVICE_ACCOUNT_JSON=

# Server
RAVA_PORT=4000
NODE_ENV=development

# Razorpay payments (leave unset to run in demo-payments mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
APP_ORIGIN=https://app.rava.one

# Meta / Instagram for rava.one/myacc (from your existing Meta app — never commit real values)
# Connect (full card): Facebook Login for Business config "Rava myacc Connect".
# Valid OAuth Redirect URI must include https://rava.one/myacc (and localhost for local).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://rava.one/myacc
# Optional override; defaults to Rava myacc Connect (2159564441320574).
INSTAGRAM_LOGIN_CONFIG_ID=2159564441320574
# Business Discovery (handle-only limited card): our own IG Business/Creator account
# linked to a Facebook Page, plus a long-lived user token with
# instagram_basic, instagram_manage_insights, pages_read_engagement.
META_DISCOVERY_IG_ID=
META_DISCOVERY_TOKEN=
