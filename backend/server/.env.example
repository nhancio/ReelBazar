# Firebase Admin
RAVA_FIREBASE_PROJECT_ID=your-project-id
RAVA_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
RAVA_FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
RAVA_FIREBASE_CLIENT_EMAIL=
RAVA_FIREBASE_PRIVATE_KEY=
RAVA_FIREBASE_SERVICE_ACCOUNT_JSON=

# Server
RAVA_PORT=4000
NODE_ENV=development

# Razorpay payments (leave unset to run in demo-payments mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
APP_ORIGIN=https://app.rava.one
