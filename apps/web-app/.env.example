# Local dev API URL. For production builds, set this in .env.production.
# Must include /api/v1 (client paths are /auth/..., /reels/...). Legacy /api is still accepted by the backend.
VITE_API_URL=http://localhost:4000/api/v1
# Public site URLs (defaults in @reelbazaar/config match production: app.rava.one, rava.one)
# VITE_APP_ORIGIN=https://app.rava.one
# VITE_LANDING_ORIGIN=https://rava.one
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-reelbazaar
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
