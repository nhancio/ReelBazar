{
  "name": "app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "start:fresh": "expo start --dev-client --clear",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "web": "expo start --web",
    "web:fresh": "expo start --web --clear",
    "build": "expo export --platform web",
    "lint": "expo lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck",
    "prebuild:native": "expo prebuild --clean",
    "assets:generate": "node scripts/buildAssets.js",
    "play:assets": "node scripts/buildAssets.js",
    "play:preflight": "node scripts/playStorePreflight.js",
    "play:screenshots": "node scripts/verifyPlayStoreScreenshots.js",
    "play:version:sync": "node scripts/syncAndroidVersionFromPlay.js",
    "build:apk": "bash scripts/buildapk.sh",
    "build:aab": "bash scripts/buildaab.sh",
    "push:apk": "bash scripts/pushapk.sh",
    "push:ios": "bash scripts/pushios.sh",
    "expo:apk": "bash scripts/expoapk.sh",
    "expo:ios": "bash scripts/expoios.sh",
    "expo:update": "bash scripts/expoupdate.sh",
    "release:check": "node scripts/releasePreflight.js",
    "release:check:android": "node scripts/releasePreflight.js android",
    "release:check:ios": "node scripts/releasePreflight.js ios",
    "release:sync:android-version": "node scripts/syncAndroidVersionFromPlay.js",
    "release:build:android:eas": "bash scripts/ensurePlayVersionCode.sh && npm run release:check:android -- --require-clean && eas build --platform android --profile production",
    "release:build:ios:eas": "npm run release:check:ios -- --require-clean && eas build --platform ios --profile production",
    "release:build:android:local": "bash scripts/buildAndroidLocal.sh",
    "release:build:android:preview:local": "bash scripts/buildAndroidPreviewLocal.sh",
    "release:submit:android:eas": "npm run release:check:android -- --require-clean && node scripts/syncAndroidVersionFromPlay.js --check && eas submit --platform android --profile production --latest",
    "release:submit:ios:eas": "npm run release:check:ios -- --require-clean && eas submit --platform ios --profile production --latest",
    "eas:env:sync": "bash scripts/eas-env-sync.sh"
  },
  "dependencies": {
    "@expo/ui": "~56.0.26",
    "@expo/vector-icons": "^15.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@reelbazaar/api": "*",
    "@reelbazaar/config": "*",
    "expo": "~56.0.19",
    "expo-apple-authentication": "~56.0.4",
    "expo-application": "~56.0.3",
    "expo-asset": "~56.0.22",
    "expo-auth-session": "~56.0.16",
    "expo-blur": "~56.0.4",
    "expo-build-properties": "~56.0.25",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.23",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.24",
    "expo-file-system": "~56.0.9",
    "expo-font": "~56.0.7",
    "expo-glass-effect": "~56.0.4",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-image-picker": "~56.0.23",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.16",
    "expo-router": "~56.2.18",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.24",
    "expo-video": "~56.1.4",
    "expo-web-browser": "~56.0.6",
    "firebase": "^12.14.0",
    "idb": "^7.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.0",
    "react-native-razorpay": "^3.0.0",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20.19.0 <21"
  }
}
