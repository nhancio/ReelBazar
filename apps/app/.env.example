# Copy to .env for local development. Never commit the filled-in copy.
#
# ⚠️ Every EXPO_PUBLIC_* value is embedded in the shipped client bundle — the web JS AND
# the app binary. Anything that must stay secret belongs on the backend (Cloud Functions
# secrets or backend/server/.env), never here. In particular, the Firebase Admin service
# account key must NEVER appear in this file or anywhere under apps/app/.

# ---- Backend API ----
# Dev: leave blank to hit the local Express server through the Expo dev proxy.
# Prod: the deployed Cloud Functions API base, e.g. https://app.rava.one/api/v1
EXPO_PUBLIC_API_URL=

# ---- Origins ----
EXPO_PUBLIC_APP_ORIGIN=https://app.rava.one
EXPO_PUBLIC_LANDING_ORIGIN=https://rava.one

# ---- Payments (Razorpay) ----
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# ---- Firebase web config (safe to ship in the client bundle) ----
# Firebase console -> Project settings -> Your apps -> Web app.
# These are NOT secrets: access is controlled by Auth + Firestore/Storage security rules,
# not by hiding these values.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---- Google Sign-In ----
# Google Cloud Console -> APIs & Services -> Credentials. You need three OAuth client IDs.
# The Android client requires the SHA-1 of the EAS keystore (`eas credentials`), and the
# iOS client must match the bundle identifier in app.config.js (com.nhancio.rava).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# ---- EAS ----
# Set by `eas init`. Drives the OTA update URL and extra.eas.projectId in app.config.js.
EXPO_PUBLIC_EAS_PROJECT_ID=

# ---- Build environment ----
# Set automatically by the EAS build profiles; only override locally for testing.
# EXPO_PUBLIC_APP_ENV=development
